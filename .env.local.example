# Optional local overrides for development. Copy to `.env.local` (gitignored)
# and load it with your tool of choice (direnv, mise, `set -a; . ./.env.local`).
# The values below match the services in docker-compose.dev.yml.

# --- Postgres (task services:up) ---
# HBOX_DATABASE_DRIVER=postgres
# HBOX_DATABASE_USERNAME=homebox
# HBOX_DATABASE_PASSWORD=homebox
# HBOX_DATABASE_DATABASE=homebox
# HBOX_DATABASE_HOST=localhost
# HBOX_DATABASE_PORT=5432
# HBOX_DATABASE_SSL_MODE=disable

# --- Mailpit (task services:up) — UI at http://localhost:8025 ---
# Host must be "localhost": Go's SMTP client only sends credentials over
# plaintext to localhost. Mailpit accepts any username/password.
# HBOX_MAILER_HOST=localhost
# HBOX_MAILER_PORT=1025
# HBOX_MAILER_USERNAME=homebox
# HBOX_MAILER_PASSWORD=homebox
# HBOX_MAILER_FROM=homebox@localhost
# Base URL for links in emails; required for password-reset emails to be sent.
# HBOX_OPTIONS_HOSTNAME=http://localhost:3000
