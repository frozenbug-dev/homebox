{
  "expo": {
    "name": "Homecrate",
    "slug": "homecrate",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homecrate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.frozenbug.homecrate",
      "appleTeamId": "4AZ6RJF693",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "$(PRODUCT_NAME) uses the camera to photograph items and scan labels.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.frozenbug.homecrate",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-nitro-fetch",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "$(PRODUCT_NAME) lets you attach photos from your library to items.",
          "microphonePermission": false
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_scan": {
              "foregroundImage": "./assets/shortcuts/shortcut_scan.png",
              "backgroundColor": "#5e6ad2"
            },
            "shortcut_item": {
              "foregroundImage": "./assets/shortcuts/shortcut_item.png",
              "backgroundColor": "#5e6ad2"
            },
            "shortcut_place": {
              "foregroundImage": "./assets/shortcuts/shortcut_place.png",
              "backgroundColor": "#5e6ad2"
            },
            "shortcut_tag": {
              "foregroundImage": "./assets/shortcuts/shortcut_tag.png",
              "backgroundColor": "#5e6ad2"
            }
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# ML Kit (barcode scanner): R8 full mode breaks its internal component wiring,\n# so creating a scanner throws a NullPointerException in release builds.\n-keep class com.google.mlkit.** { *; }\n-keep class com.google.android.gms.internal.mlkit_vision_** { *; }\n-keep class com.google.android.gms.vision.** { *; }\n-keep class com.google.firebase.components.** { *; }"
          }
        }
      ],
      "./plugins/with-sdwebimage-modular-headers"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8b81d242-4cf3-475d-81c0-acc7f96376ea"
      }
    },
    "owner": "frozenbug"
  }
}
